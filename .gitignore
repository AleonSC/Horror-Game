# Unity: folders Unity rebuilds itself (only at the project root, so an Assets folder
# that happens to be called "Library" or "Build" isn't ignored by mistake)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity: generated files
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*

# IDE / OS
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
.DS_Store
Thumbs.db
Desktop.ini

# Builds
*.apk
*.aab
*.exe

# Asset Store packs: their licence doesn't allow sharing them in a public repo, so they stay
# on your PC only. Put future packs in Assets/Packs/ and they're left out automatically.
/[Aa]ssets/polyperfect/
/[Aa]ssets/polyperfect.meta
/[Aa]ssets/Tree9/
/[Aa]ssets/Tree9.meta
/[Aa]ssets/[Pp]acks/
/[Aa]ssets/[Pp]acks.meta
